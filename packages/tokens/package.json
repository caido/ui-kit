{
  "name": "@caido/tokens",
  "version": "0.1.0-beta.3",
  "description": "Design tokens for Caido",
  "author": "Caido Labs Inc. <dev@caido.io>",
  "repository": "https://github.com/caido/ui-kit",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./legacy.css": "./dist/legacy.css",
    "./plugin-compat.css": "./dist/plugin-compat.css",
    "./plugin-primevue.css": "./dist/plugin-primevue.css",
    "./plugin-utilities.css": "./dist/plugin-utilities.css",
    "./plugin-light.css": "./dist/plugin-light.css",
    "./plugin-light-important.css": "./dist/plugin-light-important.css",
    "./primevue.css": "./dist/primevue.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublish": "pnpm build",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json && node --experimental-strip-types scripts/assets.ts",
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "contrast": "node --experimental-strip-types scripts/contrast.ts",
    "contract": "node --experimental-strip-types scripts/contract.ts",
    "codemod": "node --experimental-strip-types scripts/codemod.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "@types/node": "22.17.2",
    "neverthrow": "6.1.0",
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vitest": "3.2.7"
  }
}
